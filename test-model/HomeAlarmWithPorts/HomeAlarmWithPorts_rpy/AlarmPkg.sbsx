			<_description type="p"><IDescription type="e">
				<_textRTF type="a">{\rtf1\fbidis\ansi\ansicpg1255\deff0\deflang1037{\fonttbl{\f0\fnil\fcharset0 MS Sans Serif;}{\f1\fnil\fcharset177 MS Sans Serif;}}%0D
\viewkind4\uc1\pard\ltrpar\f0\fs17 When the alarm is armed, the house lights can be switched on and off to simulate presence.\par%0D
\par%0D
One upstairs and one downstairs light, will be switched on/off independently when ever the alarm is active.\par%0D
\par%0D
The timing of switching on and off the lights is to be defined\f1\rtlch\par%0D
}%0D
</_textRTF>
			</IDescription>
			</_description>
