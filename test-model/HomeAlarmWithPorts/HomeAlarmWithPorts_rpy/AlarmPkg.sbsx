		<IRequirement type="e">
			<_id type="a">GUID 95f3345c-8c76-412c-9611-4bdba58f1b6f</_id>
			<_name type="a">DelayAfterArm</_name>
			<_modifiedTimeWeak type="a">12.31.1969::16:0:0</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">After the alarm is armed there is an exit delay to allow homeowner to leave without triggering the alarm</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">12.31.1969::16:0:0</_modifiedTime>
		</IRequirement>
		<IRequirement type="e">
			<_id type="a">GUID cc97b33b-e606-4df1-b8cd-1502b2fe0e4e</_id>
			<_name type="a">DoorOpening</_name>
			<_modifiedTimeWeak type="a">12.31.1969::16:0:0</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">While armed, if the door is opened the alarm will sound after an entry delay, unless the alarm is disarmed during the delay time.</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">12.31.1969::16:0:0</_modifiedTime>
		</IRequirement>
		<IRequirement type="e">
			<_id type="a">GUID f4f5e0ee-067e-44c3-8a83-0ce2069d03ed</_id>
			<_name type="a">Presence</_name>
			<_modifiedTimeWeak type="a">12.31.1969::16:0:0</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">If a presence is detected while armed a siren is sounded.</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">12.31.1969::16:0:0</_modifiedTime>
		</IRequirement>
		<IRequirement type="e">
			<_id type="a">GUID 1fa650aa-e5a2-4588-8873-fd7863c462c2</_id>
