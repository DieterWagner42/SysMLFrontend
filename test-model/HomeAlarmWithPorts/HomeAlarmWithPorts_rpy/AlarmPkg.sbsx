		<IRequirement type="e">
			<_id type="a">GUID baf87232-30e4-4f00-809f-be60864cde18</_id>
			<_name type="a">ArmingViaKeypad</_name>
			<_modifiedTimeWeak type="a">12.31.1969::16:0:0</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">The alarm can be armed or disarmed by entering a 4 digit code</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">12.31.1969::16:0:0</_modifiedTime>
		</IRequirement>
		<IRequirement type="e">
			<_id type="a">GUID fdebe67b-b35f-477d-90a0-79dd6715b2db</_id>
			<_name type="a">ArmingViaRemote</_name>
			<_modifiedTimeWeak type="a">12.31.1969::16:0:0</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_text type="a">The alarm can be armed and dsiarmed by a remote control</_text>
			</IDescription>
			</_description>
			<_modifiedTime type="a">12.31.1969::16:0:0</_modifiedTime>
		</IRequirement>
