		<IUseCase type="e">
			<_id type="a">OLDID 1424988 333</_id>
			<_name type="a">detect intrusions</_name>
			<_modifiedTimeWeak type="a">11.23.2003::14:28:33</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_textRTF type="a">{\rtf1\fbidis\ansi\ansicpg1255\deff0\deflang1037{\fonttbl{\f0\fnil\fcharset0 MS Sans Serif;}{\f1\fnil\fcharset177 MS Sans Serif;}}%0D
\viewkind4\uc1\pard\ltrpar\f0\fs17 Will detect two types of intrusion:\par%0D
\par%0D
1. The door will allow a temporised delay for entering into the house and disarming the alarm. \par%0D
\par%0D
2. A movement detection will action the alarm immediately.\par%0D
\f1\rtlch\par%0D
}%0D
</_textRTF>
			</IDescription>
			</_description>
