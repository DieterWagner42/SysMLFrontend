			<_id type="a">OLDID 1424988 329</_id>
			<_name type="a">changing code</_name>
			<_modifiedTimeWeak type="a">11.23.2003::14:25:34</_modifiedTimeWeak>
			<_theMainDiagram type="r">
				<IHandle type="e">
					<_hm2Class type="a">IUCDiagram</_hm2Class>
					<_hfilename type="a">.\the_home_alarm.ucdx</_hfilename>
					<_hsubsystem type="a">AlarmPkg</_hsubsystem>
					<_hname type="a">the home alarm</_hname>
					<_hid type="a">OLDID 18398194 1</_hid>
				</IHandle>
			</_theMainDiagram>
			<_description type="p"><IDescription type="e">
				<_textRTF type="a">{\rtf1\fbidis\ansi\ansicpg1255\deff0\deflang1037{\fonttbl{\f0\fnil\fcharset0 MS Sans Serif;}{\f1\fnil\fcharset177 MS Sans Serif;}}%0D
\viewkind4\uc1\pard\ltrpar\f0\fs17 To change the code, the homeowner must do the following :\par%0D
\par%0D
key on\par%0D
enter old code\par%0D
key on\par%0D
enter new code\par%0D
key on\par%0D
\par%0D
If the code is successfully changed the green led will flash four times.\f1\rtlch\par%0D
}%0D
</_textRTF>
			</IDescription>
			</_description>
			<_modifiedTime type="a">12.31.1969::16:0:0</_modifiedTime>
