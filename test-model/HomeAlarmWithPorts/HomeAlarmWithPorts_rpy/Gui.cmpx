		<IFileFragment type="e">
			<_id type="a">GUID 330aacad-2b00-11d3-ac15-0010a4f1d0f6</_id>
			<_name type="a">Script that runs automatically on starting animation</_name>
			<_modifiedTimeWeak type="a">12.31.1969::16:0:0</_modifiedTimeWeak>
			<_modifiedTime type="a">12.31.1969::16:0:0</_modifiedTime>
			<m_type type="a">textFragment</m_type>
			<m_text type="a">// Switch off the animation before starting%0D
display%0D
// Run with animation off to create all objects%0D
go idle%0D
// Switch animation back on%0D
watch%0D
// Run continuously%0D
go</m_text>
			<m_startRow type="a">0</m_startRow>
			<m_startCol_Short type="a">0</m_startCol_Short>
