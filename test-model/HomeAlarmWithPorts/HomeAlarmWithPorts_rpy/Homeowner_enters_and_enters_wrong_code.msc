	- _name = "Homeowner enters and enters wrong code";
	- _description = { IDescription 
		- _textRTF = "{\\rtf1\\fbidis\\ansi\\ansicpg1255\\deff0\\deflang1037{\\fonttbl{\\f0\\fnil\\fcharset0 MS Sans Serif;}{\\f1\\fnil\\fcharset177 MS Sans Serif;}}
\\viewkind4\\uc1\\pard\\ltrpar\\f0\\fs17 Scenario where the homeowner enters the house and initially fails to enter the correct code. The alarm is activated. Finally the correct code is entered and the alarm is silenced.\\f1\\rtlch\\par
}";
	}
