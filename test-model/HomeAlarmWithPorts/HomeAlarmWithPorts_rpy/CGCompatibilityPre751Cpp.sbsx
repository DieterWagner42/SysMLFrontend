############# Target type (Debug/Release) ##################%0D
############################################################%0D
CPPCompileDebug=$OMCPPCompileDebug%0D
CPPCompileRelease=$OMCPPCompileRelease%0D
LinkDebug=$OMLinkDebug%0D
LinkRelease=$OMLinkRelease%0D
BuildSet=$OMBuildSet%0D
SUBSYSTEM=$OMSubSystem%0D
COM=$OMCOM%0D
RPFrameWorkDll=$OMRPFrameWorkDll%0D
DEF_EXT=$OMDEFExtension%0D
DLL_EXT=$OMDllExtension%0D
ConfigurationCPPCompileSwitches=$OMConfigurationCPPCompileSwitches%0D
%0D
!IF &quot;$(RPFrameWorkDll)&quot; == &quot;True&quot;%0D
ConfigurationCPPCompileSwitches=$(ConfigurationCPPCompileSwitches) /D &quot;FRAMEWORK_DLL&quot;%0D
!ENDIF%0D
%0D
!IF &quot;$(COM)&quot; == &quot;True&quot;%0D
SUBSYSTEM=/SUBSYSTEM:windows%0D
!ENDIF%0D
%0D
################### Compilation flags ######################%0D
############################################################%0D
INCLUDE_QUALIFIER=/I%0D
LIB_PREFIX=MS%0D
CRT_FLAGS=%0D
ENABLE_EH=/GX%0D
%0D
!IF &quot;$(MS_VER)&quot;==&quot;VC9&quot;%0D
LIB_PREFIX=MSVC9%0D
CRT_FLAGS=/D &quot;_CRT_SECURE_NO_DEPRECATE&quot;%0D
ENABLE_EH=/EHa%0D
!ENDIF%0D
%0D
################### Commands definition #########################%0D
#################################################################%0D
DLL_CMD=link.exe -dll%0D
LINK_CMD=link.exe%0D
DLL_FLAGS=$OMConfigurationLinkSwitches%0D
LINK_FLAGS=$OMConfigurationLinkSwitches $(SUBSYSTEM) /MACHINE:I386 %0D
%0D
############### Generated macros #################%0D
##################################################%0D
$OMContextMacros%0D
%0D
######################## Predefined macros ############################%0D
#######################################################################%0D
!IF &quot;$(OBJS)&quot; != &quot;&quot;%0D
$(OBJS) : $(FLAGSFILE) $(RULESFILE) $(INST_LIBS) $(OXF_LIBS)%0D
!ENDIF%0D
%0D
LIB_EXT=.lib%0D
%0D
%0D
LIB_POSTFIX=%0D
!IF &quot;$(BuildSet)&quot;==&quot;Release&quot;%0D
LIB_POSTFIX=R%0D
!ENDIF%0D
%0D
!IF &quot;$(TARGET_TYPE)&quot; == &quot;Executable&quot;%0D
LinkDebug=$(LinkDebug) /DEBUG%0D
LinkRelease=$(LinkRelease) /OPT:NOREF%0D
!ELSEIF &quot;$(TARGET_TYPE)&quot; == &quot;Library&quot;%0D
LinkDebug=$(LinkDebug) /DEBUG /DEBUGTYPE:CV%0D
LinkRelease=$(LinkRelease) /OPT:NOREF%0D
!ENDIF%0D
%0D
!IF &quot;$(TIME_MODEL)&quot; == &quot;Simulated&quot;%0D
TIM_EXT=%0D
!ELSEIF &quot;$(TIME_MODEL)&quot; == &quot;RealTime&quot;%0D
TIM_EXT=%0D
!ELSE%0D
!ERROR An invalid Time Model &quot;$(TIME_MODEL)&quot; is specified.%0D
!ENDIF%0D
%0D
!IF &quot;$(INSTRUMENTATION)&quot; == &quot;Animation&quot;%0D
INST_FLAGS=/D &quot;OMANIMATOR&quot;%0D
INST_INCLUDES=/I $(OMROOT)\LangCpp\aom /I $(OMROOT)\LangCpp\tom%0D
!IF &quot;$(RPFrameWorkDll)&quot; == &quot;True&quot;%0D
INST_LIBS= %0D
OXF_LIBS=$(OMROOT)\LangCpp\lib\$(LIB_PREFIX)oxfanimdll$(LIB_POSTFIX)$(LIB_EXT) %0D
!ELSE%0D
INST_LIBS= $(OMROOT)\LangCpp\lib\$(LIB_PREFIX)aomanim$(LIB_POSTFIX)$(LIB_EXT)%0D
OXF_LIBS=$(OMROOT)\LangCpp\lib\$(LIB_PREFIX)oxf$(TIM_EXT)inst$(LIB_POSTFIX)$(LIB_EXT) $(OMROOT)\LangCpp\lib\$(LIB_PREFIX)omComAppl$(LIB_POSTFIX)$(LIB_EXT)%0D
!ENDIF%0D
SOCK_LIB=wsock32.lib%0D
%0D
!ELSEIF &quot;$(INSTRUMENTATION)&quot; == &quot;Tracing&quot;%0D
INST_FLAGS=/D &quot;OMTRACER&quot;%0D
INST_INCLUDES=/I $(OMROOT)\LangCpp\aom /I $(OMROOT)\LangCpp\tom%0D
!IF &quot;$(RPFrameWorkDll)&quot; == &quot;True&quot;%0D
INST_LIBS=%0D
OXF_LIBS= $(OMROOT)\LangCpp\lib\$(LIB_PREFIX)oxftracedll$(LIB_POSTFIX)$(LIB_EXT) %0D
!ELSE%0D
INST_LIBS=$(OMROOT)\LangCpp\lib\$(LIB_PREFIX)tomtrace$(LIB_POSTFIX)$(LIB_EXT) $(OMROOT)\LangCpp\lib\$(LIB_PREFIX)aomtrace$(LIB_POSTFIX)$(LIB_EXT)%0D
OXF_LIBS= $(OMROOT)\LangCpp\lib\$(LIB_PREFIX)oxf$(TIM_EXT)inst$(LIB_POSTFIX)$(LIB_EXT) $(OMROOT)\LangCpp\lib\$(LIB_PREFIX)omComAppl$(LIB_POSTFIX)$(LIB_EXT)%0D
!ENDIF%0D
SOCK_LIB=wsock32.lib%0D
%0D
!ELSEIF &quot;$(INSTRUMENTATION)&quot; == &quot;None&quot; %0D
INST_FLAGS=%0D
INST_INCLUDES=%0D
INST_LIBS=%0D
!IF &quot;$(RPFrameWorkDll)&quot; == &quot;True&quot;%0D
OXF_LIBS=$(OMROOT)\LangCpp\lib\$(LIB_PREFIX)oxfdll$(LIB_POSTFIX)$(LIB_EXT)%0D
!ELSE%0D
OXF_LIBS=$(OMROOT)\LangCpp\lib\$(LIB_PREFIX)oxf$(TIM_EXT)$(LIB_POSTFIX)$(LIB_EXT)%0D
!ENDIF%0D
SOCK_LIB=%0D
%0D
!ELSE%0D
!ERROR An invalid Instrumentation $(INSTRUMENTATION) is specified.%0D
!ENDIF%0D
%0D
!IF &quot;$(COM)&quot; == &quot;True&quot;%0D
COM_LIB=kernel32.lib user32.lib gdi32.lib winspool.lib comdlg32.lib advapi32.lib shell32.lib ole32.lib oleaut32.lib uuid.lib odbc32.lib odbccp32.lib%0D
COM_OBJS=$(TARGET_MAIN)$(OBJ_EXT) %0D
DEF_NAME=$(TARGET_MAIN)$(DEF_EXT)%0D
LINK_DEF=/def:$(DEF_NAME)%0D
!ELSE%0D
COM_LIB=%0D
COM_OBJS=%0D
DEF_NAME=%0D
LINK_DEF=%0D
!ENDIF%0D
%0D
################## Generated dependencies ########################%0D
##################################################################%0D
$OMContextDependencies%0D
%0D
!IF &quot;$(TARGET_MAIN)&quot; != &quot;&quot;%0D
$(TARGET_MAIN)$(OBJ_EXT) : $(TARGET_MAIN)$(CPP_EXT) $(OBJS) $(FLAGSFILE) $(RULESFILE)%0D
	$(CPP) $(ConfigurationCPPCompileSwitches) /Fo&quot;$OMFileObjPath&quot; $(TARGET_MAIN)$(CPP_EXT)%0D
!ENDIF%0D
%0D
########################## Linking instructions ###############################%0D
###############################################################################%0D
!IF &quot;$(TARGET_NAME)&quot; != &quot;&quot;%0D
$(TARGET_NAME)$(EXE_EXT): $(OBJS) $(ADDITIONAL_OBJS) $(TARGET_MAIN)$(OBJ_EXT) $OMMakefileName%0D
	@echo Linking $(TARGET_NAME)$(EXE_EXT)%0D
	$(LINK_CMD)  $(TARGET_MAIN)$(OBJ_EXT) $(OBJS) $(ADDITIONAL_OBJS) \%0D
	$(LIBS) \%0D
	$(INST_LIBS) \%0D
	$(OXF_LIBS) \%0D
	$(SOCK_LIB) \%0D
	$(LINK_FLAGS) /out:$(TARGET_NAME)$(EXE_EXT)%0D
%0D
$(TARGET_NAME)$(DLL_EXT) : $(OBJS) $(ADDITIONAL_OBJS) $(COM_OBJS) $(DEF_NAME) $OMMakefileName%0D
	@echo Building library $@%0D
	$(DLL_CMD) $(DLL_FLAGS) $(COM_LIB) $(OBJS) $(COM_OBJS) $(ADDITIONAL_OBJS) \%0D
	$(LIBS) \%0D
	$(INST_LIBS) \%0D
	$(OXF_LIBS) \%0D
	$(SOCK_LIB) \%0D
	$(LINK_DEF) \%0D
	/out:$(TARGET_NAME)$(DLL_EXT)  %0D
	@echo Registering COM Server... %0D
	if exist $(TARGET_NAME)$(DLL_EXT) regsvr32 /s $(TARGET_NAME)$(DLL_EXT)%0D
%0D
!ENDIF%0D
%0D
clean:%0D
	@echo Cleanup%0D
	$OMCleanOBJS%0D
	if exist *$(OBJ_EXT) erase *$(OBJ_EXT)%0D
	if exist $(TARGET_NAME).pdb erase $(TARGET_NAME).pdb%0D
	if exist $(TARGET_NAME)$(LIB_EXT) erase $(TARGET_NAME)$(LIB_EXT)%0D
	if exist $(TARGET_NAME).ilk erase $(TARGET_NAME).ilk%0D
	if exist $(TARGET_NAME)$(EXE_EXT) erase $(TARGET_NAME)$(EXE_EXT)%0D
