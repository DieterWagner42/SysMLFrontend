			<m_name type="p">
				<CGIText type="e">
					<m_str type="a">Once a code has been entered, the on key must%0D
be pressed within three seconds.</m_str>
					<m_style type="a">Arial; 10 0 0 0 1 </m_style>
					<m_color type="p">
						<IColor type="e">
							<m_fgColor type="a">32</m_fgColor>
							<m_bgColor type="a">32</m_bgColor>
							<m_bgFlag type="a">0</m_bgFlag>
						</IColor>
					</m_color>
					<m_position type="a">1 33.0901439701731 -13.406296270874  </m_position>
