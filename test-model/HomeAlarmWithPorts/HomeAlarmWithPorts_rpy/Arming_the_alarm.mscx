			<m_name type="p">
				<CGIText type="e">
					<m_str type="a">Once a key has been pressed, the homeowner%0D
has upto five seconds to enter the code and %0D
press the on key.</m_str>
					<m_style type="a">Arial; 10 0 0 0 1 </m_style>
					<m_color type="p">
						<IColor type="e">
							<m_fgColor type="a">32</m_fgColor>
