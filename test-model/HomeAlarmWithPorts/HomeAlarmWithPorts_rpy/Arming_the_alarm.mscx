			<m_text type="a">Once a key has been pressed, the homeowner%0D
has upto five seconds to enter the code and %0D
press the on key.</m_text>
		</CGIFreeText>
		<CGIFreeText type="e">
			<_id type="a">GUID 0727cff9-f323-4a41-b6c8-6a4bfc537e7d</_id>
