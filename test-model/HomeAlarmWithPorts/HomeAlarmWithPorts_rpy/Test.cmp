				- _name = "changeCode.cfg";
				- _description = { IDescription 
					- _textRTF = "{\\rtf1\\fbidis\\ansi\\ansicpg1255\\deff0\\deflang1037{\\fonttbl{\\f0\\fnil\\fcharset0 MS Sans Serif;}{\\f1\\fnil\\fcharset177 MS Sans Serif;}}
\\viewkind4\\uc1\\pard\\ltrpar\\f0\\fs17 Simple script to test changing the code. Executed by typing:\\par
input changecode.cfg\\par
Expects that the current code is 1234.\\f1\\rtlch\\par
}
";
				}
				- m_path = "..\\..";
				- m_type = userFile;
				- Fragments = { IRPYRawContainer 
					- size = 1;
					- value = 
					{ IFileFragment 
						- _id = GUID 9c2ce58b-3059-11d4-9383-0010a4f1d0f6;
						- _name = "Script to change the code from 1234 to 5678";
						- m_type = textFragment;
						- m_text = "go idle
set focus @theAlarmCtrl->theKeypad
// trace everything into a file changecode.log
trace #All all
output ChangeCode.log

go idle

// enter reprogram mode via the keypad
theAlarmCtrl->theKeypad->GEN(evKeyOff)
go idle

theAlarmCtrl->theKeypad->GEN(evKeyOn)
go idle
// enter old code
theAlarmCtrl->theKeypad->GEN(evKey(1))
go idle
theAlarmCtrl->theKeypad->GEN(evKey(2))
go idle
theAlarmCtrl->theKeypad->GEN(evKey(3))
go idle
theAlarmCtrl->theKeypad->GEN(evKey(4))
go idle
theAlarmCtrl->theKeypad->GEN(evKeyOn)
go idle

//enter new code
theAlarmCtrl->theKeypad->GEN(evKey(5))
go idle
theAlarmCtrl->theKeypad->GEN(evKey(6))
go idle
theAlarmCtrl->theKeypad->GEN(evKey(7))
go idle
theAlarmCtrl->theKeypad->GEN(evKey(8))
go idle
theAlarmCtrl->theKeypad->GEN(evKeyOn)
break AlarmController operation flashGreenLed
go";
						- m_startRow = 0;
						- m_startCol = 0;
						- m_subject = { INObjectHandle 
							- _m2Class = "";
						}
					}
				}
			}
