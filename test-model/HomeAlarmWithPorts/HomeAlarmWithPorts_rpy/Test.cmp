				- m_path = "..\\..";
				- m_type = userFile;
				- Fragments = { IRPYRawContainer 
					- size = 1;
					- value = 
					{ IFileFragment 
						- _id = GUID d91bf0af-15fb-11d4-9319-0010a4f1d0f6;
						- _name = "Script to test alarm controller";
						- _description = { IDescription 
							- _textRTF = "{\\rtf1\\fbidis\\ansi\\ansicpg1255\\deff0\\deflang1037{\\fonttbl{\\f0\\fnil\\fcharset0 MS Sans Serif;}{\\f1\\fnil\\fcharset177 MS Sans Serif;}}
\\viewkind4\\uc1\\pard\\ltrpar\\f0\\fs17 Script that arms the alarm and generates a door event to set off the alarm.\\f1\\rtlch\\par
}
";
						}
						- m_type = textFragment;
						- m_text = "// script to arm and generate a Door event
// make sure disarmed
go idle

AlarmController->GEN(evDisarm)
go idle

// arm via the keypad
Keypad->GEN(evKey(1))
Keypad->GEN(evKey(2))
Keypad->GEN(evKey(3))
Keypad->GEN(evKey(4))

Keypad->GEN(evKeyOn)

// set breakpoint when entering the detecting state
break AlarmController stateEntered detecting

// run until we hit the breakpoint
go

AlarmController->GEN(evDoor)

go 

// now in detecting state so remove breakpoint
break AlarmController -stateEntered detecting
";
						- m_startRow = 0;
						- m_startCol = 0;
						- m_subject = { INObjectHandle 
							- _m2Class = "";
						}
					}
				}
			}
			{ IFile 
				- _id = GUID 107dc8ff-2346-11d3-abfa-0010a4f1d0f6;
				- _myState = 32768;
				- _properties = { IPropertyContainer 
					- Subjects = { IRPYRawContainer 
						- size = 1;
						- value = 
						{ IPropertySubject 
							- _Name = "CG";
							- Metaclasses = { IRPYRawContainer 
								- size = 1;
								- value = 
