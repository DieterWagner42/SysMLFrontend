				- _name = "Requirements.txt";
				- _description = { IDescription 
					- _textRTF = "{\\rtf1\\fbidis\\ansi\\ansicpg1255\\deff0\\deflang1037{\\fonttbl{\\f0\\fnil\\fcharset0 MS Sans Serif;}{\\f1\\fnil\\fcharset177 MS Sans Serif;}}
\\viewkind4\\uc1\\pard\\ltrpar\\f0\\fs17 textual requirements for the HomeAlarm\\f1\\rtlch\\par
}
";
				}
				- m_path = "..\\..";
				- m_type = userFile;
				- Fragments = { IRPYRawContainer 
					- size = 1;
					- value = 
					{ IFileFragment 
						- _id = GUID 3ac52937-b8d2-49d9-960b-45d24a88e5fb;
						- _name = "Requirements";
						- m_type = textFragment;
						- m_text = "Can be armed / disarmed either via a remote control unit or via a 
simple keypad. When using a keypad to arm the alarm, a four-digit
code must be entered followed by the on key. To disarm the alarm, 
a four-digit code must be entered followed by the off key.  It should
be possible to change the code.
When the alarm is armed and a presence is detected, the alarm
will sound immediately. When arming the alarm, there is an exit 
delay to allow the homeowner to exit. When opening the door 
when the alarm is armed, there is an entry delay during which the 
homeowner can disarm the alarm, failing to do so will result in the 
alarm going off.
The home alarm system should also be capable of switching lights 
on/off to simulate presence in the house.
The alarm will have two LED's, one green and one red. 
The red led will indicate the alarm is active, 
the green will indicate that the alarm is powered up.
";
						- m_startRow = 0;
						- m_startCol = 0;
						- m_subject = { INObjectHandle 
							- _m2Class = "";
						}
					}
				}
			}
