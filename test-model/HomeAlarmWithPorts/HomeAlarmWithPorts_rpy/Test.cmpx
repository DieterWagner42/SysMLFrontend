			<_name type="a">changeCode.cfg</_name>
			<_modifiedTimeWeak type="a">12.31.1969::16:0:0</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_textRTF type="a">{\rtf1\fbidis\ansi\ansicpg1255\deff0\deflang1037{\fonttbl{\f0\fnil\fcharset0 MS Sans Serif;}{\f1\fnil\fcharset177 MS Sans Serif;}}%0D
\viewkind4\uc1\pard\ltrpar\f0\fs17 Simple script to test changing the code. Executed by typing:\par%0D
input changecode.cfg\par%0D
Expects that the current code is 1234.\f1\rtlch\par%0D
}%0D
</_textRTF>
			</IDescription>
			</_description>
			<_modifiedTime type="a">12.31.1969::16:0:0</_modifiedTime>
			<m_path type="a">..\..</m_path>
			<m_type type="a">userFile</m_type>
			<AggregatesList type="e">
				<value>GUID 9c2ce58b-3059-11d4-9383-0010a4f1d0f6</value>
			</AggregatesList>
		</IFile>
		<IFileFragment type="e">
			<_id type="a">GUID 9c2ce58b-3059-11d4-9383-0010a4f1d0f6</_id>
			<_name type="a">Script to change the code from 1234 to 5678</_name>
			<_modifiedTimeWeak type="a">12.31.1969::16:0:0</_modifiedTimeWeak>
			<_modifiedTime type="a">12.31.1969::16:0:0</_modifiedTime>
			<m_type type="a">textFragment</m_type>
			<m_text type="a">go idle%0D
set focus @theAlarmCtrl-&gt;theKeypad%0D
// trace everything into a file changecode.log%0D
trace #All all%0D
output ChangeCode.log%0D
%0D
go idle%0D
%0D
// enter reprogram mode via the keypad%0D
theAlarmCtrl-&gt;theKeypad-&gt;GEN(evKeyOff)%0D
go idle%0D
%0D
theAlarmCtrl-&gt;theKeypad-&gt;GEN(evKeyOn)%0D
go idle%0D
// enter old code%0D
theAlarmCtrl-&gt;theKeypad-&gt;GEN(evKey(1))%0D
go idle%0D
theAlarmCtrl-&gt;theKeypad-&gt;GEN(evKey(2))%0D
go idle%0D
theAlarmCtrl-&gt;theKeypad-&gt;GEN(evKey(3))%0D
go idle%0D
theAlarmCtrl-&gt;theKeypad-&gt;GEN(evKey(4))%0D
go idle%0D
theAlarmCtrl-&gt;theKeypad-&gt;GEN(evKeyOn)%0D
go idle%0D
%0D
//enter new code%0D
theAlarmCtrl-&gt;theKeypad-&gt;GEN(evKey(5))%0D
go idle%0D
theAlarmCtrl-&gt;theKeypad-&gt;GEN(evKey(6))%0D
go idle%0D
theAlarmCtrl-&gt;theKeypad-&gt;GEN(evKey(7))%0D
go idle%0D
theAlarmCtrl-&gt;theKeypad-&gt;GEN(evKey(8))%0D
go idle%0D
theAlarmCtrl-&gt;theKeypad-&gt;GEN(evKeyOn)%0D
break AlarmController operation flashGreenLed%0D
go</m_text>
