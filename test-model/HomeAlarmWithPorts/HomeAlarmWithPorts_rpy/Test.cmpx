			<_name type="a">script.cfg</_name>
			<_modifiedTimeWeak type="a">12.31.1969::16:0:0</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_textRTF type="a">{\rtf1\fbidis\ansi\ansicpg1255\deff0\deflang1037{\fonttbl{\f0\fnil\fcharset0 MS Sans Serif;}{\f1\fnil\fcharset177 MS Sans Serif;}}%0D
\viewkind4\uc1\pard\ltrpar\f0\fs17 Simple script to test the alarm controller. Executed by typing:\par%0D
input script.cfg\f1\rtlch\par%0D
}%0D
</_textRTF>
			</IDescription>
			</_description>
			<_modifiedTime type="a">12.31.1969::16:0:0</_modifiedTime>
			<m_path type="a">..\..</m_path>
			<m_type type="a">userFile</m_type>
			<AggregatesList type="e">
				<value>GUID d91bf0af-15fb-11d4-9319-0010a4f1d0f6</value>
			</AggregatesList>
		</IFile>
		<IFileFragment type="e">
			<_id type="a">GUID d91bf0af-15fb-11d4-9319-0010a4f1d0f6</_id>
			<_name type="a">Script to test alarm controller</_name>
			<_modifiedTimeWeak type="a">12.31.1969::16:0:0</_modifiedTimeWeak>
			<_description type="p"><IDescription type="e">
				<_textRTF type="a">{\rtf1\fbidis\ansi\ansicpg1255\deff0\deflang1037{\fonttbl{\f0\fnil\fcharset0 MS Sans Serif;}{\f1\fnil\fcharset177 MS Sans Serif;}}%0D
\viewkind4\uc1\pard\ltrpar\f0\fs17 Script that arms the alarm and generates a door event to set off the alarm.\f1\rtlch\par%0D
}%0D
</_textRTF>
			</IDescription>
			</_description>
			<_modifiedTime type="a">12.31.1969::16:0:0</_modifiedTime>
			<m_type type="a">textFragment</m_type>
			<m_text type="a">// script to arm and generate a Door event%0D
// make sure disarmed%0D
go idle%0D
%0D
AlarmController-&gt;GEN(evDisarm)%0D
go idle%0D
%0D
// arm via the keypad%0D
Keypad-&gt;GEN(evKey(1))%0D
Keypad-&gt;GEN(evKey(2))%0D
Keypad-&gt;GEN(evKey(3))%0D
Keypad-&gt;GEN(evKey(4))%0D
%0D
Keypad-&gt;GEN(evKeyOn)%0D
%0D
// set breakpoint when entering the detecting state%0D
break AlarmController stateEntered detecting%0D
%0D
// run until we hit the breakpoint%0D
go%0D
%0D
AlarmController-&gt;GEN(evDoor)%0D
%0D
go %0D
%0D
// now in detecting state so remove breakpoint%0D
break AlarmController -stateEntered detecting%0D
</m_text>
			<m_startRow type="a">0</m_startRow>
			<m_startCol_Short type="a">0</m_startCol_Short>
			<m_endRow type="a">0</m_endRow>
			<m_endCol_Short type="a">0</m_endCol_Short>
			<m_subject type="r">
				<INObjectHandle type="e">
				</INObjectHandle>
			</m_subject>
		</IFileFragment>
		<IFile type="e">
			<_id type="a">GUID 107dc8ff-2346-11d3-abfa-0010a4f1d0f6</_id>
